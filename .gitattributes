# Normalize line endings to LF in the repo; keep text as UTF-8 (no BOM — see
# AGENTS.md "Encoding & Russian text" + the encoding guard test).
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.gguf binary
*.db binary
*.lock binary
