# ═══ Elira AI — environment template ═══
# Copy to .env.local and fill in. OS env vars always win (override=False).
# .env.local is gitignored — never commit secrets.

# ── Local LLM provider (OpenAI-compatible llama-server) ──────────────────────
LLAMA_SERVER_ENABLED=true
LLAMA_SERVER_BASE_URL=http://192.168.88.15:8000/v1
LLAMA_SERVER_MODEL=local-model
LLAMA_SERVER_API_KEY=local
LLAMA_SERVER_TIMEOUT_SECONDS=600
LLAMA_SERVER_CONTEXT_WINDOW=131072
# LLAMA_SERVER_MAX_TOKENS=        # optional, leave unset for server default

# ── Embeddings provider (OpenAI-compatible /v1/embeddings, for RAG memory) ───
LOCAL_EMBED_ENABLED=true
LOCAL_EMBED_BASE_URL=http://192.168.88.15:8001/v1
LOCAL_EMBED_MODEL=local-embed
LOCAL_EMBED_API_KEY=local
LOCAL_EMBED_TIMEOUT_SECONDS=30
LOCAL_EMBED_DIM=1024

# ── Vision provider (image → text description, OpenAI-compatible :8004) ──────
# Images uploaded to the library are sent here; the returned description becomes
# the file preview the chat/agent sees. Explicit tools always attempt this
# configured service and fail closed when it is unavailable.
VISION_BASE_URL=http://192.168.88.15:8004/v1
VISION_MODEL=vision-model
VISION_API_KEY=local
VISION_TIMEOUT_SECONDS=180
VISION_MAX_TOKENS=1024
# VISION_PROMPT=                    # optional, override the default RU describe prompt

# ── OCR provider (scanned-PDF / document text, multipart REST :8002) ─────────
# Scanned PDFs (little embedded text) are sent here; local pytesseract is the
# fallback when the server is unreachable. Explicit tools are not feature-gated.
OCR_URL=http://192.168.88.15:8002/ocr
OCR_LANGUAGE=auto                  # auto | ru | en
OCR_PDF_FALLBACK=true
OCR_TIMEOUT_SECONDS=300

# ── API auth ─────────────────────────────────────────────────────────────────
# Loopback (Tauri/dev) is trusted without a token. LAN/mobile callers need one.
# Leave ELIRA_API_TOKEN unset to auto-generate into data/elira_api_token.
# ELIRA_API_TOKEN=
# ELIRA_API_AUTH=on               # set to "off" to disable enforcement

# ── Web search (optional) ────────────────────────────────────────────────────
# Self-hosted SearXNG metasearch (primary). Empty -> search degrades to the
# keyless DuckDuckGo/Wikipedia fallback (different failure domain). No API key.
# SEARXNG_URL=http://192.168.88.15:8003

# ── Voice / TTS (optional) ───────────────────────────────────────────────────
# Self-hosted Silero v4_ru TTS (CPU, LAN) for Elira's voice. Default :8005.
# Strictly local — audio never leaves the network.
# ELIRA_TTS_URL=http://192.168.88.15:8005
# Self-hosted faster-whisper STT (CPU, LAN) for voice input. Default :8006.
# ELIRA_STT_URL=http://192.168.88.15:8006

# ── Misc (optional) ──────────────────────────────────────────────────────────
# HF_HOME=D:\AIWork\Elira_AI\models\huggingface   # HuggingFace cache for image-gen
# ELIRA_DATA_DIR=                  # override runtime data dir (default: repo data/)
