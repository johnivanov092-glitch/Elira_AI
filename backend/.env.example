# ═══ Elira AI — environment template ═══
# Copy to .env.local and fill in. OS env vars always win (override=False).
# .env.local is gitignored — never commit secrets.

# ── Local LLM provider (OpenAI-compatible llama-server) ──────────────────────
LLAMA_SERVER_ENABLED=true
LLAMA_SERVER_BASE_URL=http://192.168.88.15:8000/v1
LLAMA_SERVER_MODEL=local-model
LLAMA_SERVER_API_KEY=local
LLAMA_SERVER_TIMEOUT_SECONDS=600
LLAMA_SERVER_CONTEXT_WINDOW=32768
# LLAMA_SERVER_MAX_TOKENS=        # optional, leave unset for server default

# ── Embeddings provider (OpenAI-compatible /v1/embeddings, for RAG memory) ───
LOCAL_EMBED_ENABLED=true
LOCAL_EMBED_BASE_URL=http://192.168.88.15:8001/v1
LOCAL_EMBED_MODEL=local-embed
LOCAL_EMBED_API_KEY=local
LOCAL_EMBED_TIMEOUT_SECONDS=30

# ── API auth ─────────────────────────────────────────────────────────────────
# Loopback (Tauri/dev) is trusted without a token. LAN/mobile callers need one.
# Leave ELIRA_API_TOKEN unset to auto-generate into data/elira_api_token.
# ELIRA_API_TOKEN=
# ELIRA_API_AUTH=on               # set to "off" to disable enforcement

# ── Web search (optional) ────────────────────────────────────────────────────
# TAVILY_API_KEY=tvly-...

# ── Misc (optional) ──────────────────────────────────────────────────────────
# HF_HOME=D:\AIWork\Elira_AI\models\huggingface   # HuggingFace cache for image-gen
# ELIRA_DATA_DIR=                  # override runtime data dir (default: repo data/)
