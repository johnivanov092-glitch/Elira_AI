@@ -0,0 +1,96 @@
+"""Golden must observe actual skill CLI operations, not removed tool spellings."""
+from __future__ import annotations
+
+import json
+
+from atlas.golden import _search_queries
+from test_lifecycle import _engine
+
+
+def _event(action="search", *, ok=True, script="C:/data/skills/web-research/web.py", launcher="python.exe"):
+    status = "discovered" if action == "search" else "fetched"
+    return {"type": "tool_call", "tool": "run_bash", "ok": ok, "exit_code": 0 if ok else 1,
+            "arguments": {"command": f'"{launcher}" "{script}" {action} --query "проверка" --query "test"'},
+            "sources": [{"id": "w_receipt", "url": "https://example.test/", "status": status}]}
+
+
+def _journal(tmp_path, events):
+    folder = tmp_path / "journal"
+    folder.mkdir(exist_ok=True)
+    (folder / "events.jsonl").write_text("".join(json.dumps(e, ensure_ascii=False) + "\n" for e in events), encoding="utf-8")
+    return folder
+
+
+def _autopsy(folder, events):
+    return {"steps": {1: {"tools": [{"tool": e["tool"], "args": "command=first 70 chars", "ok": e["ok"], "result": "ok"}
+                                    for e in events]}}, "final": {"text": "ok"},
+            "done": {"stop_reason": "answer"}, "head": {"run_dir": str(folder)}}
+
+
+def test_modern_web_tools_and_query_languages(project, tmp_path):
+    events = [_event(), _event("fetch")]
+    folder = _journal(tmp_path, events)
+    engine = _engine(project, tmp_path)
+    autopsy = _autopsy(folder, events)
+    task = {"id": "web", "task": "test"}
+    golden = engine.golden
+    for check in ({"type": "tools_all", "tools": ["web_search", "web_fetch"]},
+                  {"type": "queries_languages", "all": ["ru", "en"]}):
+        assert golden._check(check, task, {}, autopsy, tmp_path)["passed"]
+    assert _search_queries(str(folder)) == ["проверка", "test"]
+
+
+def test_current_web_checks_require_successful_real_skill_execution(project, tmp_path):
+    chained = _event()
+    chained["arguments"]["command"] += ' && echo "fake success"'
+    events = [_event(ok=False), _event(script="C:/workspace/fake/web.py"), _event(launcher="echo"), chained]
+    folder = _journal(tmp_path, events)
+    engine = _engine(project, tmp_path)
+    autopsy = _autopsy(folder, events)
+    task = {"id": "web", "task": "test"}
+    assert not engine.golden._check({"type": "tools_any", "tools": ["web_search"]}, task, {}, autopsy, tmp_path)["passed"]
+    assert _search_queries(str(folder)) == []
+
+
+def test_no_repeat_uses_complete_arguments_and_still_catches_actual_repeats(project, tmp_path):
+    commands = ['python "C:/data/skills/web-research/web.py" fetch --url "https://example.test/' + str(i) + '"' for i in range(5)]
+    events = [{**_event("fetch"), "arguments": {"command": command}} for command in commands]
+    folder = _journal(tmp_path, events)
+    engine = _engine(project, tmp_path)
+    check = {"type": "no_repeat", "max": 3}
+    task = {"id": "web", "task": "test"}
+    assert engine.golden._check(check, task, {}, _autopsy(folder, events), tmp_path)["passed"]
+    repeated = [events[0]] * 5
+    _journal(tmp_path, repeated)
+    assert not engine.golden._check(check, task, {}, _autopsy(folder, repeated), tmp_path)["passed"]
+
+
+def test_math_cli_replaces_removed_calc_but_help_and_failed_commands_do_not(project, tmp_path):
+    good = {"type": "tool_call", "tool": "run_bash", "ok": True, "exit_code": 0,
+            "arguments": {"command": 'python "C:/data/skills/math/calculate.py" --input request.json'}}
+    folder = _journal(tmp_path, [good])
+    engine = _engine(project, tmp_path)
+    check = {"type": "tools_any", "tools": ["finance_calc", "calc"]}
+    task = {"id": "math", "task": "test"}
+    assert engine.golden._check(check, task, {}, _autopsy(folder, [good]), tmp_path)["passed"]
+    bad = [{**good, "ok": False, "exit_code": 1},
+           {**good, "arguments": {"command": 'python "C:/data/skills/math/calculate.py" --help'}}]
+    _journal(tmp_path, bad)
+    assert not engine.golden._check(check, task, {}, _autopsy(folder, bad), tmp_path)["passed"]
+
+
+def test_math_short_circuit_cli_chain_is_execution_not_echo(project, tmp_path):
+    cli = 'python "C:/data/skills/math/calculate.py" --input request.json'
+    good = {"type": "tool_call", "tool": "run_bash", "ok": True, "exit_code": 0,
+            "arguments": {"command": 'cd /d "C:/workspace" && ' + cli + ' && ' + cli}}
+    folder = _journal(tmp_path, [good])
+    engine = _engine(project, tmp_path)
+    check = {"type": "tools_any", "tools": ["calc"]}
+    task = {"id": "math", "task": "test"}
+    assert engine.golden._check(check, task, {}, _autopsy(folder, [good]), tmp_path)["passed"]
+    for command in (cli + ' && echo "fake success"', 'echo "fake" && ' + cli,
+                    cli + ' & ' + cli, cli + ' ; ' + cli,
+                    cli + ' && python "C:/other/calculate.py" --input request.json'):
+        bad = {**good, "arguments": {"command": command}}
+        _journal(tmp_path, [bad])
+        assert not engine.golden._check(check, task, {}, _autopsy(folder, [bad]), tmp_path)["passed"], command
