+def _skill_cli_arguments(event: dict, skill: str, script: str) -> list[str]:
+    """Аргументы реально выполненного Python CLI указанного пакета навыка."""
+    if event.get("type") != "tool_call" or event.get("tool") != "run_bash" or event.get("ok") is not True:
+        return []
+    if event.get("exit_code") != 0:
+        return []
+    args = event.get("arguments") or {}
+    command = args.get("command") if isinstance(args, dict) else None
+    if not isinstance(command, str):
+        return []
+    try:
+        tokens = [token[1:-1] if len(token) > 1 and token[0] == token[-1] and token[0] in "\"'" else token
+                  for token in shlex.split(command, posix=False)]
+    except ValueError:
+        return []
+    if any(token in {"&", "|", "||", ";"} for token in tokens):
+        return []
+    clauses: list[list[str]] = [[]]
+    for token in tokens:
+        if token == "&&":
+            clauses.append([])
+        else:
+            clauses[-1].append(token)
+    if clauses[0] and clauses[0][0].lower() == "cd":
+        directory_args = clauses[0][1:]
+        if directory_args and directory_args[0].lower() == "/d":
+            directory_args = directory_args[1:]
+        if len(directory_args) != 1 or not directory_args[0]:
+            return []
+        clauses = clauses[1:]
+    # exit=0 proves every && clause succeeded. Mixed commands are not evidence.
+    # Web receipts are per event, so keep its operation unambiguous.
+    if not clauses or (len(clauses) > 1 and skill != "math"):
+        return []
+    arguments: list[str] = []
+    for clause in clauses:
+        if len(clause) < 3 or not re.fullmatch(r"(?:python(?:\d+(?:\.\d+)?)?|py)(?:\.exe)?",
+                                             clause[0].replace("\\", "/").rsplit("/", 1)[-1], re.I):
+            return []
+        index = 1
+        while index < len(clause) and clause[index] in {"-u", "-B"}:
+            index += 1
+        if index >= len(clause) or not re.search(r"(?:^|/)skills/" + re.escape(skill) + "/" + re.escape(script) + "$",
+                                                clause[index].replace("\\", "/"), re.I):
+            return []
+        arguments.extend(clause[index + 1:])
+    return arguments
+
+
+def _web_cli_operation(event: dict) -> tuple[set[str], list[str]]:
+    """Совместимость эталонов: успешный текущий CLI с квитанциями источников."""
+    tokens = _skill_cli_arguments(event, "web-research", "web.py")
+    index = 0
+    while index < len(tokens) and tokens[index].startswith("--"):
+        if tokens[index] == "--no-cache":
+            index += 1
+        elif tokens[index] == "--state-dir":
+            index += 2
+        else:
+            return set(), []
+    if index >= len(tokens):
+        return set(), []
+    action = tokens[index]
+    receipts = event.get("sources") or []
+    statuses = {s.get("status") for s in receipts if isinstance(s, dict) and s.get("id")
+                and isinstance(s.get("url"), str) and s["url"].startswith(("https://", "http://"))}
+    operations: set[str] = set()
+    if action in {"search", "query"} and "discovered" in statuses:
+        operations.add("web_search")
+    if action in {"fetch", "browser", "http", "query"} and statuses & {"fetched", "excerpt"}:
+        operations.add("web_fetch")
+    queries = []
+    if "web_search" in operations:
+        for pos, token in enumerate(tokens[index + 1:], index + 1):
+            if token == "--query" and pos + 1 < len(tokens):
+                queries.append(tokens[pos + 1])
+            elif token.startswith("--query="):
+                queries.append(token.split("=", 1)[1])
+            elif action == "query" and token == "--commands" and pos + 1 < len(tokens):
+                try:
+                    commands = json.loads(tokens[pos + 1])
+                except ValueError:
+                    continue
+                for sub in commands if isinstance(commands, list) else []:
+                    if not isinstance(sub, dict) or sub.get("type") != "search":
+                        continue
+                    values = sub.get("queries") or sub.get("query") or []
+                    queries.extend([values] if isinstance(values, str) else values if isinstance(values, list) else [])
+    return operations, [query for query in queries if isinstance(query, str) and query.strip()]
+
