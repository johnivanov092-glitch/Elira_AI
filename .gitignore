# ------------------------------
# Project specific heavy folders
# ------------------------------
backend/.venv/
frontend/node_modules/
__pycache__/

# ------------------------------
# Keep source, ignore generated
# ------------------------------
!backend/
!frontend/
!src-tauri/

# runtime data
backend/data/*.db
backend/data/generated/
backend/data/plugins/
backend/data/run_history.json
backend/data/smart_memory.db
backend/data/response_cache.db
backend/data/rag_memory.db

# root-level data/ runtime — DBs, generated artifacts, history, system state.
# Mirror of the backend/data ignores above. data/plugins/ stays tracked
# (intentional, not runtime/personal).
data/*.db
data/generated/
data/system/
data/run_history.json
data/feature_flags.json
data/code_agent_backups/
# MCP server list — machine-local (absolute tool paths) and may carry
# secret_headers for HTTP MCP servers; never commit.
data/mcp_servers.json
# DBHub multi-database config holds DB connection strings (credentials); never commit.
data/dbhub.toml

# Secrets / per-machine tokens — auto-generated at runtime, never commit.
# The Fernet key self-generates when absent; committing it defeats encryption.
data/elira_secret.key
data/elira_api_token

# user-uploaded runtime files — personal data, never commit
data/uploads/
data/chat_agent_workspace/
.elira_chat_uploads/
/Chat/

# local env / secrets
.env
.env.local
backend/.env
backend/.env.local

# Local agent instruction override (contains personal/machine-specific notes)
**/.elira/agent.local.md

# Serena MCP per-project dir (machine-local: LSP cache, memories, absolute paths)
.serena/

# Claude worktrees
.claude/
.claire/

# Dead Codex hooks tree (superseded by .claude/hooks; kept local only)
.codex/

# Local agent runs and launchers
/.agent/
/.tmp_pytest/
/Task_Agent.txt
/start-claude-full.ps1
/data/agent_workspace/
/data/ssh_acl.json
/data/*.db-shm
/data/*.db-wal
